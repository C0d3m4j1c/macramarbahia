---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { categories, products } from '../data/products';
import { getImage } from '../lib/images';
import { site, waLink } from '../config';

const featured = products.filter((p) => p.featured).slice(0, 6);
---

<Base>
  <section class="hero">
    <div class="container section hero__grid">
      <div>
        <span class="eyebrow">Macramé artesanal</span>
        <h1>{site.tagline}</h1>
        <p class="lead">
          Tapices, bolsos, colgantes para plantas y accesorios tejidos a mano, nudo por nudo.
          Piezas únicas para llenar tu espacio de naturaleza, diseño y alma.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/tienda">Ver la colección</a>
          <a
            class="btn btn--ghost"
            href={waLink('Hola Macramar Bahía 👋 Quiero un diseño personalizado.')}
            target="_blank"
            rel="noopener"
          >
            <WhatsAppIcon size={18} /> Pide tu diseño
          </a>
        </div>
      </div>
      <div class="hero__image">
        <Image
          src={getImage('mini-tapiz-canela.jpg')}
          alt="Mini tapiz de macramé colgado en una pared de madera con luz cálida"
          widths={[480, 720, 960]}
          sizes="(max-width: 860px) 90vw, 480px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <div class="values">
    <div class="container values__grid">
      <span>Hecho a mano</span>
      <span>Piezas únicas</span>
      <span>Decoración con alma</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Selección</span>
          <h2>Piezas destacadas</h2>
        </div>
        <a class="btn btn--ghost" href="/tienda">Ver todo</a>
      </div>
      <div class="grid">
        {featured.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Explora</span>
          <h2>Por categoría</h2>
        </div>
      </div>
      <div class="tiles">
        {
          Object.entries(categories).map(([key, c]) => (
            <a class="tile" href={`/tienda?cat=${key}`}>
              <h3>{c.label}</h3>
              <p>{c.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section story" id="marca">
    <div class="container story__grid">
      <div class="story__image">
        <Image
          src={getImage('vestido-azul.jpg')}
          alt="Vestido de macramé azul junto a plantas y luz natural"
          widths={[480, 720]}
          sizes="(max-width: 860px) 90vw, 480px"
        />
      </div>
      <div>
        <span class="eyebrow">Nuestra marca</span>
        <h2>Naturaleza, diseño, tu espacio</h2>
        <!-- TODO: reemplaza este texto con tu historia real -->
        <p>
          En Macramar Bahía cada pieza nace de las manos: se teje despacio, con cuerda de
          algodón, nudos tradicionales y mucho cuidado por el detalle. Nada se produce en serie,
          por eso cada tapiz, bolso o colgante tiene su propio carácter.
        </p>
        <p>
          Creemos en la decoración con alma: objetos que cuentan algo, que se sienten cálidos y
          que acompañan tu vida diaria. Si imaginas una medida, un color o un diseño especial, lo
          tejemos para ti.
        </p>
        <a class="btn" href={waLink('Hola Macramar Bahía 👋 Quiero cotizar una pieza a mi medida.')} target="_blank" rel="noopener">
          Cotiza una pieza a tu medida
        </a>
      </div>
    </div>
  </section>

  <section class="section cta" id="contacto">
    <div class="container">
      <span class="eyebrow" style="color:var(--sand)">Contacto</span>
      <h2>Hablemos de tu próxima pieza</h2>
      <p class="lead">Escríbenos por WhatsApp o síguenos en Instagram para ver trabajos nuevos.</p>
      <div class="cta__actions">
        <a class="btn btn--wa" href={waLink('Hola Macramar Bahía 👋')} target="_blank" rel="noopener">
          <WhatsAppIcon size={18} /> {site.whatsappDisplay}
        </a>
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">
          Instagram @{site.handle}
        </a>
      </div>
    </div>
  </section>
</Base>
