---
import { Image } from 'astro:assets';
import { categories, formatPrice, type Product } from '../data/products';
import { getImage } from '../lib/images';
import { productPath, t, type Locale } from '../i18n/ui';

interface Props {
  product: Product;
  locale: Locale;
  eager?: boolean;
}
const { product, locale, eager = false } = Astro.props;
const text = product.text[locale];
const ui = t(locale);
---

<a class="card" href={productPath(locale, product.slug)} data-category={product.category}>
  <div class="card__media">
    <Image
      src={getImage(product.image)}
      alt={text.alt}
      widths={[320, 480, 640]}
      sizes="(max-width: 600px) 90vw, 300px"
      loading={eager ? 'eager' : 'lazy'}
    />
    {product.sold && <span class="badge">{ui.product.sold}</span>}
  </div>
  <div class="card__cat">{categories[product.category][locale].label}</div>
  <h3 class="card__name">{text.name}</h3>
  <div class="card__price">
    {product.price !== null ? formatPrice(product.price, locale) : ui.product.quote}
  </div>
</a>
