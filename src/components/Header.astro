---
import { site, waLink } from '../config';
import WhatsAppIcon from './WhatsAppIcon.astro';

const hello = waLink('Hola Macramar Bahía 👋 Quisiera más información sobre sus piezas.');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label={`${site.name} — inicio`}>
      MACRAMAR
      <small>BAHÍA</small>
    </a>

    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="nav" id="nav" aria-label="Principal">
      <a href="/">Inicio</a>
      <a href="/tienda">Tienda</a>
      <a href="/#marca">Nosotros</a>
      <a href="/#contacto">Contacto</a>
      <a class="btn btn--wa" href={hello} target="_blank" rel="noopener">
        <WhatsAppIcon size={18} /> WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
