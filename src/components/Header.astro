---
import { waLink } from '../config';
import { t, homePath, shopPath, locales, localeMeta, type Locale } from '../i18n/ui';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  locale: Locale;
  paths: Record<Locale, string>;
}
const { locale, paths } = Astro.props;
const ui = t(locale);
const home = homePath(locale);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={home} class="logo" aria-label={ui.nav.homeAria}>
      MACRAMAR
      <small>BAHÍA</small>
    </a>

    <button class="nav-toggle" aria-label={ui.nav.openMenu} aria-expanded="false" aria-controls="nav">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="nav" id="nav" aria-label={ui.nav.label}>
      <a href={home}>{ui.nav.home}</a>
      <a href={shopPath(locale)}>{ui.nav.shop}</a>
      <a href={`${home}#marca`}>{ui.nav.about}</a>
      <a href={`${home}#contacto`}>{ui.nav.contact}</a>

      <div class="lang" role="group" aria-label={ui.nav.language}>
        {
          locales.map((l) =>
            l === locale ? (
              <span class="lang__item is-active" aria-current="true">
                {localeMeta[l].short}
              </span>
            ) : (
              <a
                class="lang__item"
                href={paths[l]}
                lang={localeMeta[l].htmlLang}
                hreflang={localeMeta[l].hreflang}
                aria-label={localeMeta[l].label}
              >
                {localeMeta[l].short}
              </a>
            ),
          )
        }
      </div>

      <a class="btn btn--wa" href={waLink(ui.wa.info)} target="_blank" rel="noopener">
        <WhatsAppIcon size={18} /> {ui.nav.whatsapp}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
