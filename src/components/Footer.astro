---
import { site } from '../config';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>© {year} {site.name}. {ui.footer.tagline}</div>
    <div>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram @{site.handle}</a>
      ·
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp {site.whatsappDisplay}</a>
    </div>
  </div>
</footer>
