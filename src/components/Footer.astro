---
import { site } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>© {year} {site.name}. Hecho a mano con alma.</div>
    <div>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram @{site.handle}</a>
      ·
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp {site.whatsappDisplay}</a>
    </div>
  </div>
</footer>
